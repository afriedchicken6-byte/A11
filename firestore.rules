rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == "mrwanalhm38@gmail.com" && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins registry
    match /admins/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isOwnerAdmin());
      allow write: if isOwnerAdmin();
    }

    // Public restaurant settings (e.g. delivery fee)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isOwnerAdmin();
    }

    // Daily order counters for atomic sequence generation.
    // Anyone may take the next number, but only +1 (this used to be `if true`,
    // which let any visitor reset or jump the counter).
    match /daily_counters/{dateString} {
      allow read: if true;
      allow create: if request.resource.data.dateString == dateString &&
                       request.resource.data.lastOrderNumber == 1;
      allow update: if request.resource.data.lastOrderNumber == resource.data.lastOrderNumber + 1;
      allow delete: if isOwnerAdmin();
    }

    // Orders collection
    match /orders/{orderId} {
      allow get: if true;
      allow list: if isOwnerAdmin();
      // New orders must start as 'new' (customers could previously create
      // orders that were already 'completed' or 'cancelled').
      allow create: if request.resource.data.orderNumber is number &&
                       request.resource.data.totalAmount is number &&
                       request.resource.data.orderType in ['takeaway', 'delivery'] &&
                       request.resource.data.status == 'new';
      allow update: if isOwnerAdmin();
      allow delete: if isOwnerAdmin();
    }
  }
}
